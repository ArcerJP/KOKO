{
  "name": "koko-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:md": "markdownlint-cli2",
    "lint": "eslint . && npm run lint --workspace @koko/web",
    "contract:generate": "npm run generate --workspace @koko/contract",
    "contract:check": "npm run check --workspace @koko/contract",
    "dev": "npm run build:contract && npm run dev --workspace @koko/web",
    "typecheck": "npm run build:contract && npm run typecheck --workspace @koko/web",
    "build:contract": "npm run build --workspace @koko/contract",
    "build:web": "npm run build:contract && npm run build --workspace @koko/web",
    "build": "npm run build:web",
    "test:contract": "npm run build:contract && node --test packages/contract/test/*.test.mjs",
    "test:web": "npm run build:contract && npm run test --workspace @koko/web",
    "test:e2e": "npm run test:e2e --workspace @koko/web",
    "test": "npm run test:contract && npm run test:web",
    "prepare": "husky"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.53.3",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.8",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "overrides": {
    "eslint-config-next": {
      "eslint": "9.39.5",
      "typescript-eslint": {
        "eslint": "$eslint"
      },
      "@eslint-community/eslint-utils": {
        "eslint": "$eslint"
      }
    }
  }
}
