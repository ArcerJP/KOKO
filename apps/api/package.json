{
  "name": "@koko/api",
  "private": true,
  "version": "0.0.0",
  "description": "KOKOのCloudflare Workers APIとDB契約",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types src/worker-configuration.d.ts",
    "types:check": "wrangler types src/worker-configuration.d.ts --check",
    "typecheck": "npm run types:check && tsc --noEmit && tsc --noEmit --project test/tsconfig.json",
    "test": "vitest run",
    "prebuild": "node ../../.github/scripts/patch-wrangler-r2.mjs",
    "build": "npm run types:check && wrangler deploy --dry-run --outdir dist",
    "predeploy": "node ../../.github/scripts/patch-wrangler-r2.mjs",
    "deploy": "wrangler deploy --strict"
  },
  "dependencies": {
    "@koko/contract": "0.1.0",
    "@koko/processing": "0.1.0",
    "aws4fetch": "1.0.20"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
