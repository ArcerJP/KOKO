# Supabase Dashboard > Project Settings > API Keys の publishable key のみ使用
# service_role / sb_secret_ / Google Client Secret は入れない
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 以下はサーバー専用。実環境の設定・有効化は本人確認と通し受入後だけ。
# 現状のAccess認証・正式規約等は未接続。falseのまま使用する。
KOKO_ACCOUNT_UI_ENABLED=false
KOKO_API_COOKIE_ENABLED=false
KOKO_API_PROXY_ENABLED=false
# 初回参加の専用UI/中継。API側の同名flag・固定eventと実受入が必要。
KOKO_ENROLLMENT_ENABLED=false
# お題・通報・申立て・運営画面。APIの同名flagと新SQLの受入後のみ。
KOKO_STAGE_THREE_ENABLED=false
KOKO_ADMIN_REALTIME_ENABLED=false
# フィードと認証付きメディア。個別原本は運営roleを毎回APIで検証。
KOKO_PUBLIC_FEED_ENABLED=false
KOKO_MEDIA_DELIVERY_ENABLED=false
KOKO_ADMIN_ORIGINALS_ENABLED=false
# UploadのJSON制御のみ。実R2/CORS/DB/認証受入まで有効化しない。
KOKO_UPLOAD_PROXY_ENABLED=false
# IndexedDB保存と送信画面。正式規約・実接続受入前はOFF。
KOKO_UPLOAD_UI_ENABLED=false
# 非秘密の送信先account ID。R2署名鍵はWebへ置かない。
KOKO_R2_ACCOUNT_ID=
KOKO_EVENT_ID=
KOKO_WEB_ORIGIN=
KOKO_API_UPSTREAM_ORIGIN=
# Cloudflare Access service token専用。NEXT_PUBLICへ置かない・ブラウザへ渡さない。
# 実token作成/登録/Service Auth policy設定は別の本人確認が必要。
KOKO_API_ACCESS_CLIENT_ID=
KOKO_API_ACCESS_CLIENT_SECRET=

# Cloud Run固定中継。production専用、WIF/IAM/保護認証の実受入までOFF。
# Google JSON秘密鍵やNEXT_PUBLICのrelay秘密は禁止。秘密は本人が専用欄へ入力。
KOKO_PROCESSING_RELAY_ENABLED=false
KOKO_PROCESSING_RELAY_ORIGIN=
KOKO_PROCESSING_RELAY_SECRET=
KOKO_VERCEL_PROJECT_ID=
KOKO_IMAGE_SERVICE_URL=
KOKO_IMAGE_CALLER_EMAIL=
KOKO_IMAGE_CALLER_SUBJECT=
KOKO_GOOGLE_WIF_PROVIDER_AUDIENCE=
KOKO_GOOGLE_WIF_SUBJECT_ISSUER=
KOKO_GOOGLE_WIF_SUBJECT_AUDIENCE=
KOKO_GOOGLE_WIF_SUBJECT=
