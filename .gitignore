# Environment / secrets
.env
.env.*
!.env.example

# Private local context
USER.private.md
TOOLS.local.md
MEMORY.local.md

# Keys / certificates
*.pem
*.key
*.p12
*.pfx

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Repository-local formatting tooling
node_modules/
.husky/_/
dist/
coverage/
.next/
.wrangler/
.vercel/
*.tsbuildinfo
tmp/

# Daily / temporary memory
memory/*
!memory/README.md

# Raw knowledge is private-first by default
knowledge/raw/*
!knowledge/raw/README.md
!knowledge/raw/FormatterSetting.pdf

# Dynamic work artifacts are local/private by default
work/inbox/*
!work/inbox/README.md

work/notebook/*
!work/notebook/README.md

work/outbox/*
!work/outbox/README.md

work/archive/*
!work/archive/README.md
